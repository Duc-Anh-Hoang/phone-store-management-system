# ==============================================================================
# BIẾN MÔI TRƯỜNG MẪU (ENV TEMPLATE)
# Copy file này thành .env khi triển khai môi trường thực tế và thay đổi mật khẩu
# ==============================================================================

# Cấu hình SQL Server
MSSQL_SA_PASSWORD=YourStrongPasswordHere!123
MSSQL_PORT=1433

# Cấu hình Backend Spring Boot
SPRING_DATASOURCE_URL=jdbc:sqlserver://sqlserver:1433;databaseName=QuanLyCuaHangDienThoai;encrypt=false;trustServerCertificate=true
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=YourStrongPasswordHere!123

# Cấu hình Cổng ứng dụng
BACKEND_PORT=8080
FRONTEND_PORT=80
